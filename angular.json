{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "my-first-azure-web-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/app/assets/*",
              "staticwebapp.config.json"
            ],
            "styles": [
              "src/styles.css",
              "public/css/round.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/quill/dist/quill.snow.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
             "outputPath": "dist/my-first-azure-web-app-v1.43",
            "ssr": {
              "entry": "src/server.ts"
            },
            "security": {
              "allowedHosts": [
                "myexpresswebapp.azurewebsites.net"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1024kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "my-first-azure-web-app:build:production"
            },
            "development": {
              "buildTarget": "my-first-azure-web-app:build:development"
            }
          },
          "options": {
            "port": 4200,
            "sslKey": "ssl/key.pem",
            "sslCert": "ssl/crt.pem"
          },
          "defaultConfiguration": "development"
        },
        "server": {
          "builder": "@angular/build:application",
          "options": {
             "outputPath": "dist/my-first-azure-web-app-v1.43/server",
          "tsConfig": "tsconfig.server.json",
          "outputMode": "server",
          "server": "src/main.server.ts",
          "ssr": {
              "entry": "src/main.server.ts"
            }
          },
          "configurations": {
          "production": {
            "outputHashing": "media",
            "sourceMap": false,
            "optimization": true
          },
          "development": {
            "sourceMap": true,
            "optimization": false
          }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
