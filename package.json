    "@angular/platform-browser": "21.2.1",
    "@angular/platform-server": "21.2.1",
    "@angular/router": "21.2.1",
    "@angular/ssr": "21.2.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "ngx-pagination": "^6.0.3",
    "ngx-quill": "^30.0.1",
